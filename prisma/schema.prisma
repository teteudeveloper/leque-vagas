generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vaga {
  id              String   @id @default(uuid())
  titulo          String
  empresa         String
  empresaSlug     String
  area            String
  senioridade     String
  local           String
  aceitaIniciante Boolean  @default(false)
  descricao       String
  criadaEm        DateTime @default(now())

  arquivada       Boolean  @default(false)

  candidaturas    Candidatura[]
}

model Empresa {
  slug      String   @id
  nome      String
  sobre     String
  site      String
  editadaEm DateTime @updatedAt
}

model Candidatura {
  id       String   @id @default(uuid())
  nome     String
  email    String
  vagaId   String
  vaga     Vaga     @relation(fields: [vagaId], references: [id])
  criadaEm DateTime @default(now())
}
