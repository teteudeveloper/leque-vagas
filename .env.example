# Conexão com o PostgreSQL usado pelo Prisma.
# Local (docker compose up -d db):
DATABASE_URL="postgresql://leque:leque@localhost:5434/leque_vagas?schema=public"

# Opcional: conexão direta (sem pooler), usada só pelas migrations no deploy.
# A integração do Neon cria esta variável sozinha. Sem ela, usa-se DATABASE_URL.
# DATABASE_URL_UNPOOLED="postgresql://..."

# Opcional: endereço de onde vêm as vagas e empresas publicadas (JSON).
# Sem esta variável, o site usa a pasta dados/ da branch homolog no GitHub.
# DADOS_URL="https://raw.githubusercontent.com/teteudeveloper/leque-vagas/homolog/dados"

# Opcional: URL pública do site (usada em metadados, sitemap e robots).
# Na Vercel, o domínio de produção é detectado automaticamente.
# NEXT_PUBLIC_SITE_URL="https://leque-vagas.vercel.app"
